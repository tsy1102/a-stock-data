# ══════════════════════════════════════════════════════════════
# .gitignore — V17.0 核实版(2026-08-14)
# ⚠️ 注意: 不支持行尾注释——每行仅一个模式
# 结构: 凭据 → 运行时数据 → 缓存 → 采集产物 → 临时/工具 → 编辑器
# ══════════════════════════════════════════════════════════════

# ── 凭据与密钥(不入库) ──────────────────────────────────────
# V17.0: 凭据集中在 credentials/(3 个文件); 未来新增凭据需在此追加
credentials/*
# 同花顺/fuyao API Key(交互输入自动保存)
fuyao_key.txt
# V17.0.1 防御性: 通用密钥/令牌模式(防未来新增凭据漏网)
*.key
*.pem
*.p12
*.pfx
id_rsa*
.env
*.env
# 虚拟环境
venv/
.venv/
env/

# ── 运行时输出与中间数据(可重建) ────────────────────────────
reports/
logs/
snapshots/

# ── 本地缓存(不入库, 可安全删除重建) ───────────────────────
# 根级: stock_cache.db + zhb/ + 行业映射
cache/
# V17.0 补: 股本缓存 share_capital.json(运行时生成)
stock_common/cache/
*.db
*.db-journal
*.db-wal
*.db-shm

# ── 采集产物(可重采, 保留分析结论) ─────────────────────────
# V17.0 补: 每日 raw_*.json 为可重采数据(2MB/日递增); analysis.md/映射表/pool.json 入库
docs/field_verification/*/raw_*.json

# ── Python & 测试临时缓存 ───────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.tmp
*.cache

# ── 调研沙盒(仅保留说明文件) ───────────────────────────────
scratch/*
!scratch/README.md

# ── 编辑器与 OS 配置文件 ────────────────────────────────────
.DS_Store
.reasonix/
.vscode/
.idea/
*.swp
*.swo

# ── 浏览器会话快照(含登录态) ────────────────────────────────
.playwright-mcp/

# V17.0.1: 采集日志(测试产物)
docs/field_verification/*/meta.json
